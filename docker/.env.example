# Copy to .env and fill in real values before `docker compose up`.
# Never commit the real .env file.

# --- Postgres ---
DB_NAME=househub
DB_USER=househub
DB_PASSWORD=change-me

# --- Backend (Spring Boot) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Comma-separated list of origins allowed to call the API. For the public
# deployment this should be the real site origin, not *.
CORS_ALLOWED_ORIGINS=https://jensdebakker.com

# --- Outbound email (verification / password reset) ---
# Gmail: generate an app password at https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=House Hub <no-reply@jensdebakker.com>
# Base URL used to build links inside verification/reset emails.
FRONTEND_URL=https://jensdebakker.com
# Comma-separated emails that get the ADMIN role on registration.
ADMIN_EMAILS=jens.debakker@student.vives.be

# Note: house files (shared files/images per household) are stored on disk in the
# `house-files-data` named volume (see docker-compose.yml) - no extra env vars needed.

# --- Frontend (baked into the static build at image-build time) ---
EXPO_PUBLIC_API_URL=https://jensdebakker.com/api
