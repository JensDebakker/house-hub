# Copy to .env and fill in real values before `docker compose up`.
# Never commit the real .env file.

# --- Postgres ---
DB_NAME=househub
DB_USER=househub
DB_PASSWORD=change-me

# --- Backend (Spring Boot) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Comma-separated list of origins allowed to call the API. For the public
# deployment this should be the real site origin, not *.
CORS_ALLOWED_ORIGINS=https://jensdebakker.com

# --- Frontend (baked into the static build at image-build time) ---
EXPO_PUBLIC_API_URL=https://jensdebakker.com/api
